# Configuracion de ejemplo para el backend Django y Docker Compose.
# Copia este archivo como `.env` y llena los secretos reales fuera de git.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS permite que React en localhost consuma la API durante desarrollo.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Conexion a MySQL; en Docker DB_HOST debe coincidir con el servicio `db`.
DB_NAME=hematica_db
DB_USER=root
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306

# Correo usado para recuperacion de contrasena.
DEFAULT_FROM_EMAIL=no-reply@hematica.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
